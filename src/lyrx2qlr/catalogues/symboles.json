        {"nom": "deplacement_x", "type": "longueur", "sens": "vers_lyrx", "avertissement_qgis": "Trait déplacé (effet « Déplacer » d’ArcGIS) : QGIS ne sait pas déplacer un trait seul, il est dessiné à sa place d’origine.", "lyrx": "effects[type=CIMGeometricEffectMove].offsetX", "qgis": "_deplacement", "qgis_composante": 0, "qgis_unite": "_deplacement_unit"},
        {"nom": "deplacement_y", "type": "longueur", "sens": "vers_lyrx", "lyrx": "effects[type=CIMGeometricEffectMove].offsetY", "qgis": "_deplacement", "qgis_composante": 1, "qgis_facteur": -1, "qgis_unite": "_deplacement_unit"}
