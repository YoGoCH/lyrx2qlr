        {"nom": "decalage_x", "type": "longueur", "lyrx": "effects[type=CIMGeometricEffectMove].offsetX", "qgis": "offset", "qgis_composante": 0, "qgis_unite": "offset_unit"},
        {"nom": "decalage_y", "type": "longueur", "lyrx": "effects[type=CIMGeometricEffectMove].offsetY", "qgis": "offset", "qgis_composante": 1, "qgis_facteur": -1, "qgis_unite": "offset_unit"}
      ]
    },
