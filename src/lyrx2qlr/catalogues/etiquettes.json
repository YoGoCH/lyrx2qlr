    {"nom": "visible", "type": "booleen", "lyrx": "visibility", "qgis": "rendering@drawLabels", "defaut": true},
    {"nom": "police", "type": "texte", "lyrx": "textSymbol.symbol.fontFamilyName", "qgis": "text-style@fontFamily", "defaut": "Arial"},
    {"nom": "style_police", "type": "liste", "liste": "styles_police", "lyrx": "textSymbol.symbol.fontStyleName", "qgis": "text-style@namedStyle", "defaut": "normal"},
    {"nom": "taille", "type": "nombre", "lyrx": "textSymbol.symbol.height", "qgis": "text-style@fontSize", "defaut": 10, "qgis_si_present": {"text-style@fontSizeUnit": "Point"}},
    {"nom": "couleur", "type": "couleur", "lyrx": "textSymbol.symbol.symbol.symbolLayers[type=CIMSolidFill].color", "qgis": "text-style@textColor", "defaut": [0, 0, 0, 255]},
    {"nom": "casse", "type": "liste", "liste": "casse_texte", "lyrx": "textSymbol.symbol.textCase", "qgis": "text-style@capitalization", "defaut": "normale"},
    {"nom": "halo_taille", "type": "longueur", "lyrx": "textSymbol.symbol.haloSize", "lyrx_si": {"textSymbol.symbol.haloSymbol": "!null"}, "qgis": "text-style/text-buffer@bufferSize", "qgis_unite": "text-style/text-buffer@bufferSizeUnits", "qgis_si": {"text-style/text-buffer@bufferDraw": "1"}, "qgis_si_present": {"text-style/text-buffer@bufferDraw": "1"}},
    {"nom": "halo_couleur", "type": "couleur", "lyrx": "textSymbol.symbol.haloSymbol.symbolLayers[type=CIMSolidFill].color", "qgis": "text-style/text-buffer@bufferColor", "qgis_si": {"text-style/text-buffer@bufferDraw": "1"}},
    {"nom": "echelle_min", "type": "nombre", "lyrx": "minimumScale", "qgis": "rendering@scaleMax", "qgis_si": {"rendering@scaleVisibility": "1"}, "qgis_si_present": {"rendering@scaleVisibility": "1"}, "zero_est_absent": true},
    {"nom": "echelle_max", "type": "nombre", "lyrx": "maximumScale", "qgis": "rendering@scaleMin", "qgis_si": {"rendering@scaleVisibility": "1"}, "qgis_si_present": {"rendering@scaleVisibility": "1"}, "zero_est_absent": true},
    {"nom": "placement", "geometrie": "surface", "type": "liste", "liste": "placement_etiquette_surface", "lyrx": "maplexLabelPlacementProperties.polygonPlacementMethod", "qgis": "placement@placement", "defaut": "horizontal"},
    {"nom": "placement", "geometrie": "ligne", "type": "liste", "liste": "placement_etiquette_ligne", "lyrx": "maplexLabelPlacementProperties.linePlacementMethod", "qgis": "placement@placement", "defaut": "parallele"},
    {"nom": "placement", "geometrie": "point", "type": "liste", "liste": "placement_etiquette_point", "lyrx": "maplexLabelPlacementProperties.pointPlacementMethod", "qgis": "placement@placement", "defaut": "autour"},
    {"nom": "decalage", "type": "longueur", "lyrx": "maplexLabelPlacementProperties.primaryOffset", "qgis": "placement@dist", "qgis_unite": "placement@distUnits"}
  ]
}
