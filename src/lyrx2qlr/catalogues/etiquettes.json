      "polygonPlacementMethod": "HorizontalInPolygon",
      "linePlacementMethod": "OffsetCurvedFromLine",
      "pointPlacementMethod": "AroundPoint",
      "primaryOffset": 0,
      "primaryOffsetUnit": "Point"
    },
    "name": "Classe 1",
    "priority": -1,
    "standardLabelPlacementProperties": {
